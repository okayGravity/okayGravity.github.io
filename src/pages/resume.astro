---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import {
  summary,
  education,
  skills,
  certifications,
  competitions,
  otherTraining,
  experience,
} from '../data/resume';
---

<BaseLayout title="Resume" description={`Resume of ${profile.name}.`}>
  <p class="prompt">cat resume.txt</p>
  <h1>Resume</h1>
  <p class="muted">{profile.tagline} · {profile.location}</p>

  <section aria-labelledby="summary">
    <h2 id="summary">Summary</h2>
    <p>{summary}</p>
  </section>

  <section aria-labelledby="education">
    <h2 id="education">Education</h2>
    <h3>{education.school}</h3>
    <p>
      {education.degree}, minor in {education.minor}<br />
      <span class="muted">
        Anticipated graduation {education.graduation}
        {education.showGpa && ` · GPA ${education.gpa}`}
      </span>
    </p>
    <details>
      <summary>Relevant coursework</summary>
      <ul>{education.coursework.map((c) => <li>{c}</li>)}</ul>
    </details>
    <h3 class="sub">Honor societies</h3>
    <ul>{education.honors.map((h) => <li>{h}</li>)}</ul>
  </section>

  <section aria-labelledby="competitions">
    <h2 id="competitions">Competitions</h2>
    <ul>
      {competitions.map((c) => <li><strong>{c.name}:</strong> {c.result}</li>)}
    </ul>
    <p class="muted">{otherTraining}</p>
  </section>

  <section aria-labelledby="certifications">
    <h2 id="certifications">Certifications</h2>
    <ul>{certifications.map((c) => <li>{c}</li>)}</ul>
  </section>

  <section aria-labelledby="skills">
    <h2 id="skills">Skills</h2>
    <dl>
      {skills.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    {experience.map((job) => (
      <article class="job">
        <h3>{job.role}, {job.org}</h3>
        <p class="muted">{job.start} – {job.end} · {job.location}</p>
        <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  section h3 { margin-top: var(--space-3); }
  .sub { font-size: 1rem; }
  details { margin-block: var(--space-3); }
  summary { cursor: pointer; font-family: var(--font-mono); }
  dl div { margin-bottom: var(--space-3); }
  dt { font-family: var(--font-mono); font-weight: 700; }
  dd { margin: 0; color: var(--fg-muted); }
  .job + .job { margin-top: var(--space-4); }
</style>
